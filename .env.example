# ==============================================================================
# EviChain - Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Endpoint Base URL
# For local development with default Express port:
NEXT_PUBLIC_API_URL=http://localhost:4000

# For deployed production environment (e.g. Vercel / Render / Railway):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.gov

# Port configuration for the Next.js frontend (default 3000)
PORT=3000
