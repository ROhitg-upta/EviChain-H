{
  "name": "evichain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"next,api\" -c \"cyan,magenta\" \"next dev\" \"npm --prefix server run dev\"",
    "dev:client": "next dev",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n \"next,api\" -c \"cyan,magenta\" \"next dev\" \"npm --prefix server run dev\"",
    "build": "next build",
    "build:server": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:server",
    "start": "next start",
    "start:server": "npm --prefix server run start",
    "test:server": "npm --prefix server run test",
    "api:start": "npx pm2 start ecosystem.config.js",
    "api:stop": "npx pm2 stop evichain-api",
    "api:restart": "npx pm2 restart evichain-api",
    "api:status": "npx pm2 status",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "^16.3.3",
    "next-pwa": "^5.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
