generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  INVESTIGATOR
  AUDITOR
  CUSTODIAN
}

enum EvidenceStatus {
  PENDING
  VERIFIED
  FLAGGED
  SEALED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  currentCustodyEvidence Evidence[]             @relation("CurrentCustodian")
  custodyEventsFrom      CustodyEvent[]         @relation("CustodyEventFromUser")
  custodyEventsTo        CustodyEvent[]         @relation("CustodyEventToUser")
  casesLed             Case[]                 @relation("CaseLead")
  evidenceAdded        Evidence[]             @relation("EvidenceCollector")
  custodyEvents        CustodyEvent[]         @relation("CustodyEventActor")
  auditLogs            AuditLog[]

  comments             CaseComment[]
  commentMentions      CommentMention[]       @relation("CommentMentions")
  notificationPrefs    NotificationPreference?
  annotations          EvidenceAnnotation[]   @relation("AnnotationUser")
  notifications        Notification[]
  searchPresets        SearchPreset[]
  sessions             Session[]

  @@index([role])
  @@index([isActive])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Case {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("Active")
  priority    String   @default("Medium")
  leadUserId  String
  lead        User     @relation("CaseLead", fields: [leadUserId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidence Evidence[]
  comments CaseComment[]
  integrityAssessments IntegrityAssessment[]
  integrityFindings    IntegrityFinding[]

  @@index([status])
  @@index([leadUserId])
  @@index([createdAt])
}

model Evidence {
  id                 String         @id @default(uuid())
  caseId             String?
  case               Case?          @relation(fields: [caseId], references: [id])
  name               String
  type               String
  ownerOrg           String
  description        String?
  status             EvidenceStatus @default(PENDING)

  sizeBytes          Int
  mimeType           String
  sha256             String
  storageKey         String
  collectedById      String
  collectedBy        User           @relation("EvidenceCollector", fields: [collectedById], references: [id])
  currentCustodianId String?
  currentCustodian   User?          @relation("CurrentCustodian", fields: [currentCustodianId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  custodyEvents        CustodyEvent[]
  annotations          EvidenceAnnotation[]
  integrityAssessments IntegrityAssessment[]
  integrityFindings    IntegrityFinding[]

  @@index([sha256])
  @@index([caseId, createdAt])
  @@index([status])
  @@index([collectedById])
  @@index([currentCustodianId])
  @@index([storageKey])
}

model CustodyEvent {
  id           String   @id @default(uuid())
  evidenceId   String
  evidence     Evidence @relation(fields: [evidenceId], references: [id])
  action       String
  actorUserId  String
  actor        User     @relation("CustodyEventActor", fields: [actorUserId], references: [id])
  fromUserId   String?

  fromUser     User?    @relation("CustodyEventFromUser", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?    @relation("CustodyEventToUser", fields: [toUserId], references: [id])
  fromLocation String?
  toLocation   String?
  note         String
  ipAddress    String?
  timestamp    DateTime @default(now())

  @@index([evidenceId, timestamp])
  @@index([actorUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([action])
}


model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  resourceType String
  resourceId   String
  detailJson   Json
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([resourceType, resourceId, timestamp])
  @@index([actorUserId, timestamp])
  @@index([action])
}


model NotificationPreference {
  id               String  @id @default(uuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceUploads  Boolean @default(true)
  caseUpdates      Boolean @default(true)
  custodyTransfers Boolean @default(true)
  securityAlerts   Boolean @default(true)
  auditActivity    Boolean @default(false)
  reportReady      Boolean @default(true)
  systemAlerts     Boolean @default(true)
  weeklyDigest     Boolean @default(false)
}

model CaseComment {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  parentId  String?
  parent    CaseComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   CaseComment[] @relation("CommentReplies")
  mentions  CommentMention[]
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
}

model CommentMention {
  id            String      @id @default(uuid())
  commentId     String
  comment       CaseComment @relation(fields: [commentId], references: [id])
  userId        String
  mentionedUser User        @relation("CommentMentions", fields: [userId], references: [id])

  @@index([commentId])
  @@index([userId])
}

model EvidenceAnnotation {
  id          String    @id @default(uuid())
  evidenceId  String
  evidence    Evidence  @relation(fields: [evidenceId], references: [id])
  userId      String
  user        User      @relation("AnnotationUser", fields: [userId], references: [id])
  type        String    // POINT, REGION, PAGE_NOTE, freehand, arrow, highlight, text
  points      Json?
  coordinates Json?
  pageNumber  Int?
  text        String?
  note        String?
  color       String    @default("#22d3ee")
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([evidenceId, createdAt])
  @@index([userId])
  @@index([deletedAt])
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String    // CASE_CREATED, EVIDENCE_UPLOADED, CUSTODY_TRANSFER_RECEIVED, etc.
  severity       String    @default("INFO") // INFO, SUCCESS, WARNING, HIGH, CRITICAL, SECURITY
  actionRequired Boolean   @default(false)
  actionType     String?
  actionPayload  Json?
  dismissedAt    DateTime?
  resolvedAt     DateTime?
  groupingKey    String?
  expiresAt      DateTime?
  title          String
  message        String
  link           String?
  entityType     String?
  entityId       String?
  metadataJson   Json?
  read           Boolean   @default(false)
  readAt         DateTime?
  dedupeKey      String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, read, severity, createdAt])
  @@index([userId, actionRequired, createdAt])
  @@index([groupingKey])
}

model SearchPreset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model IntegrityAssessment {
  id               String             @id @default(uuid())
  caseId           String?
  case             Case?              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId       String?
  evidence         Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  assessmentType   String             // "EVIDENCE" | "CASE"
  overallScore     Int                // 0 - 100
  overallStatus    String             // "HEALTHY" | "NEEDS_REVIEW" | "AT_RISK" | "CRITICAL"
  findingsSummary  Json               // { total: number, critical: number, high: number, medium: number, low: number }
  assessedAt       DateTime           @default(now())
  assessedByUserId String?
  source           String             @default("ON_DEMAND") // "ON_DEMAND" | "SCHEDULED" | "EVENT_TRIGGERED"
  engineVersion    String             @default("1.0.0")
  createdAt        DateTime           @default(now())

  findings         IntegrityFinding[]

  @@index([caseId, assessedAt])
  @@index([evidenceId, assessedAt])
  @@index([assessmentType, assessedAt])
}

model IntegrityFinding {
  id                   String               @id @default(uuid())
  assessmentId         String?
  assessment           IntegrityAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  caseId               String?
  case                 Case?                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId           String?
  evidence             Evidence?            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  code                 String               // e.g. "HASH_MISMATCH_DETECTED", "CUSTODY_GAP", "MISSING_CUSTODY_ORIGIN"
  severity             String               // "INFO" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  title                String
  description          String
  remediation          String
  status               String               @default("OPEN") // "OPEN" | "ACKNOWLEDGED" | "RESOLVED" | "FALSE_POSITIVE"
  evidenceJson         Json?                // Safe operational metadata (no private storage keys/tokens)
  detectedAt           DateTime             @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionNote       String?
  dedupeKey            String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt @default(now())

  @@index([evidenceId, status])
  @@index([caseId, status])
  @@index([severity, status])
  @@index([detectedAt])
}

model IntegrityScanJob {
  id                String    @id @default(uuid())
  scopeType         String    // "EVIDENCE" | "CASE" | "SYSTEM"
  scopeId           String?
  status            String    @default("QUEUED") // "QUEUED" | "RUNNING" | "COMPLETED" | "FAILED"
  requestedByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  summaryJson       Json?
  createdAt         DateTime  @default(now())

  @@index([scopeType, scopeId])
  @@index([status, createdAt])
}

