# ==============================================================================
# EviChain - Backend API Environment Configuration (.env.example)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evichain?schema=public"

# Security & JWT Authentication
# In production, JWT_SECRET and REFRESH_SECRET MUST be different and at least 16 chars.
JWT_SECRET=super-secret-jwt-key-min-16-chars-evichain
JWT_EXPIRES_IN=15m
REFRESH_SECRET=super-secret-refresh-key-min-16-chars-evichain
REFRESH_EXPIRES_IN=7d

# CORS & Allowed Frontend Origins (Comma-separated supported)
# Allows Next.js frontend on localhost:3000, 127.0.0.1:3000, and production URLs
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://evi-chain-h.vercel.app

# Storage Configuration ('local' or 's3')
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads
MAX_FILE_SIZE_BYTES=52428800

# S3 Storage Configuration (Optional when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=evichain-forensic-vault
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
